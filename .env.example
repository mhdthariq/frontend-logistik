# Backend origin for browser requests, including production builds (no /api suffix).
# Leave empty to use the frontend domain's /api reverse proxy.
# Example: VITE_API_ORIGIN=https://api.your-domain.com
VITE_API_ORIGIN=

# Development and local preview proxy when VITE_API_ORIGIN is empty.
GO_API_ORIGIN=https://backend-logistik-gamma.vercel.app

# Public build-time values only. Never put credentials in VITE_* variables.
VITE_COMPANY_NAME=NovaLogistik
# Development uses the production login for the deployed API; preview builds use preview.
# Match the backend NODE_ENV and PREVIEW_MODE when overriding this.
# VITE_RUNTIME_MODE=production
VITE_PREVIEW_CORP_ID=TRIAL
